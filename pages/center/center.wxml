<!-- pages/center/center.wxml 个人中心 -->
<view class="center_page">

  <!-- 头部：头像 / 昵称 / 手机号（缺省均有兜底） -->
  <view class="profile_card">
    <!-- 头像：有则用真实头像，无则展示默认头像（渐变圆形 + 「车」字） -->
    <view class="avatar_wrap" bindtap="onProfileTap">
      <image wx:if="{{avatarUrl}}" class="avatar_img" src="{{avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar_default">
        <text class="avatar_txt">车</text>
      </view>
    </view>
    <view class="profile_info" bindtap="onProfileTap">
      <view class="nickname">{{isLogin ? nickname : '未登录，点击登录'}}</view>
      <!-- 绑定手机号：无则不展示这一行 -->
      <view class="phone" wx:if="{{phone}}">{{phone}}</view>
    </view>
  </view>

  <!-- 功能入口：联系客服与订单页一致，用微信客服会话按钮；其余点击处理 -->
  <view class="menu_card">
    <block wx:for="{{menus}}" wx:key="key">
      <!-- 联系客服：open-type="contact" 直接唤起微信客服会话，无需登录 -->
      <button wx:if="{{item.key === 'kefu'}}" class="menu_item btn_kefu_item" open-type="contact" hover-class="menu_item_hover">
        <view class="menu_icon {{item.iconClass}}">{{item.icon}}</view>
        <view class="menu_name">{{item.name}}</view>
        <view class="menu_arrow"></view>
      </button>
      <view wx:else class="menu_item" hover-class="menu_item_hover" bindtap="onMenuTap" data-name="{{item.name}}" data-key="{{item.key}}">
        <view class="menu_icon {{item.iconClass}}">{{item.icon}}</view>
        <view class="menu_name">{{item.name}}</view>
        <view class="menu_arrow"></view>
      </view>
    </block>
  </view>

</view>
