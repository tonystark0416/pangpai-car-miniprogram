/* pages/login/login.wxss —— iOS 风格 */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
}

.banner {
  width: 100%;
}
.banner image {
  width: 100%;
  display: block;
}

.loginForm {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  align-items: center;
  padding-bottom: 120rpx;
}

/* iOS 蓝色胶囊主按钮 */
.b_login {
  width: 86%;
}

.login-btn {
  background-color: var(--pp-blue);
  color: #FFFFFF;
  border-radius: 88rpx;
  font-size: 34rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
}
.login-btn::after {
  border: none;
}

/* 协议勾选 */
.agreement {
  width: 80%;
  display: flex;
  justify-content: center;
  font-size: 26rpx;
  color: var(--pp-text-2);
}
.agreement_text {
  margin-left: 8rpx;
}
.agreement_link {
  color: var(--pp-blue);
}
