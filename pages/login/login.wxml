<!--pages/login/login.wxml-->
<view class = "page">
  <view class="banner">
    <image src="/img/WechatIMG3004.jpeg" mode="widthFix"/>
  </view>
  <view class = "loginForm">
    <view class="b_login">
      <button class="login-btn" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">手机号一键登录</button>
    </view>
    <view class="agreement">
      <checkbox-group bindchange="agreementChange">
        <checkbox value="agree" checked="{{agreement}}" />
        <text class="agreement_text">我已阅读并同意</text>
        <text class="agreement_link">《庞派租车会员注册协议》</text>
      </checkbox-group>
    </view>
  </view>
</view>
