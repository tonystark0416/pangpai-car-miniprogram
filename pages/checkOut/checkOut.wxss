/* pages/checkOut/checkOut.wxss —— iOS 风格 */
page {
  background-color: var(--pp-bg);
  width: 100%;
  overflow-x: hidden;
}

.checkOutPage {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  overflow-x: hidden;
  padding-bottom: 40rpx;
}

/* 结算信息卡片 */
.checkout-info {
  margin-top: 24rpx;
  border-radius: var(--pp-radius-lg);
  width: 92%;
  background-color: var(--pp-card);
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.car-info {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
}

.car-name-tag {
  padding-left: 30rpx;
  width: 70%;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
}
.car-name-tag .car-name {
  font-size: 40rpx;
  font-weight: 600;
}
.car-name-tag .car-tag {
  font-size: 24rpx;
  color: var(--pp-text-2);
}

.car-pic {
  padding-right: 30rpx;
  width: 30%;
}
.car-pic image {
  width: 100%;
}

.checkout-time-address {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-evenly;
  padding: 0 30rpx 24rpx;
}
.quche-time, .huanche-time {
  font-size: 30rpx;
  font-weight: 600;
}
.quche-address, .huanche-address {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  color: var(--pp-text-2);
}
.address_info {
  font-size: 26rpx;
  color: var(--pp-text-2);
}

/* 保险信息 */
.insurance_info {
  margin-top: 24rpx;
  border-radius: var(--pp-radius-lg);
  width: 92%;
  background-color: var(--pp-card);
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  padding: 30rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.insurance_info_title {
  font-size: 34rpx;
  font-weight: 600;
  margin-left: 30rpx;
}
.insurance_info_title .ins_required {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--pp-text-2);
}
.insurance_info_content {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-evenly;
}
.insurance_info_list {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
}
.ins_cost {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--pp-blue);
  margin-top: 8rpx;
}
.ins_rule {
  font-size: 24rpx;
  color: var(--pp-text-2);
  margin-top: 6rpx;
}

/* 身份证信息 */
.user-info {
  margin-top: 24rpx;
  border-radius: var(--pp-radius-lg);
  width: 92%;
  background-color: var(--pp-card);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 30rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.user-info .title {
  padding-left: 30rpx;
  font-size: 34rpx;
  font-weight: 600;
}
.driver-info {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.user-info .driver-idcard {
  padding-left: 30rpx;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--pp-text-2);
}
.idcard_botton {
  margin-right: 30rpx;
  background-color: var(--pp-blue);
  text-align: center;
  border-radius: 88rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 16rpx 36rpx;
}

/* 联系电话 */
.driver-phone {
  margin-top: 24rpx;
  border-radius: var(--pp-radius-lg);
  width: 92%;
  background-color: var(--pp-card);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 30rpx 0;
  font-size: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.driver-phone text, .driver-phone input {
  padding-left: 30rpx;
}
.driver-phone input {
  margin-top: 16rpx;
  font-size: 30rpx;
}

/* 司机服务 */
.siji_info {
  background-color: var(--pp-card);
  margin-top: 24rpx;
  width: 92%;
  border-radius: var(--pp-radius-lg);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 30rpx 0;
  font-size: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.siji_text {
  font-size: 24rpx;
  color: var(--pp-text-2);
}

/* 费用明细 */
.cost-info {
  padding: 30rpx 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background-color: var(--pp-card);
  margin-top: 24rpx;
  border-radius: var(--pp-radius-lg);
  width: 92%;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.cost-info .title {
  padding-left: 30rpx;
  font-size: 34rpx;
  font-weight: 600;
}
.cost-info .sub-title {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 30rpx 30rpx 0;
  font-size: 30rpx;
}
.sub-title-cost {
  padding-right: 30rpx;
  font-weight: 600;
}
.cost-info .sub-content {
  padding-left: 30rpx;
  padding-top: 8rpx;
  font-size: 24rpx;
  color: var(--pp-text-2);
}

/* 优惠券入口行（v1.7.3） */
.cost-info .coupon_row {
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--pp-sep);
}
.cost-info .coupon_value {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-right: 30rpx;
}
.cost-info .coupon_cut {
  color: var(--pp-orange);
  font-weight: 600;
}
.cost-info .coupon_hint {
  font-size: 26rpx;
  color: var(--pp-text-2);
  font-weight: 400;
}
/* 右侧箭头 */
.cost-info .coupon_arrow {
  width: 14rpx;
  height: 14rpx;
  margin-left: 10rpx;
  border-top: 3rpx solid var(--pp-text-2);
  border-right: 3rpx solid var(--pp-text-2);
  transform: rotate(45deg);
  opacity: 0.6;
}
.cost-info .sub-title-cost.pay_amount {
  color: var(--pp-orange);
}

/* 合同勾选 */
checkbox .wx-checkbox-input {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}
checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  border-color: var(--pp-blue);
  background-color: var(--pp-blue);
}
checkbox .wx-checkbox-input.wx-checkbox-input-checked::before {
  color: #FFFFFF;
}
radio .wx-radio-input {
  border-color: var(--pp-sep);
}
radio .wx-radio-input.wx-radio-input-checked {
  border-color: var(--pp-blue);
  background-color: var(--pp-blue);
}

.contract {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  font-size: 28rpx;
  align-items: center;
  width: 92%;
  margin-top: 30rpx;
  color: var(--pp-text-2);
}
.contract .contract_link {
  color: var(--pp-blue);
}

/* 提交订单栏 */
.order-submit {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  background-color: var(--pp-card);
  margin-top: 24rpx;
  border-radius: var(--pp-radius-lg);
  width: 92%;
  height: 180rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.order-submit .order-all-cost .cost-title {
  margin-right: 20rpx;
  color: var(--pp-text-2);
}
.order-submit .order-all-cost .cost-price {
  font-size: 52rpx;
  font-weight: 600;
  color: var(--pp-red);
}
.order-submit .order-button {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: var(--pp-blue);
  height: 96rpx;
  width: 42%;
  color: #FFFFFF;
  border-radius: 88rpx;
  font-size: 34rpx;
  font-weight: 600;
}
