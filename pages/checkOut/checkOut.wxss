/* pages/checkOut/checkOut.wxss */
page{
  background-color: #000000;
  width: 100%;
  overflow-x: hidden;
}

.checkOutPage{
  width: 100%;
  /* height: 100vh; */
  display: flex;
  flex-direction: column;
  justify-content:flex-start;
  align-items: center;
  overflow-x: hidden;
}

.checkout-info{
  margin-top: 20rpx;
  border-radius: 20rpx;
  height: 400rpx;
  width: 100%;
  background-color: white;
  display: flex;
  flex-direction:column;
}

.car-info{
  width: 100%;
  height: 40%;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.car-name-tag{
  padding-left: 30rpx;
  height: 100%;
  width: 70%;
  display: flex;
  flex-direction: column;
  justify-content:space-evenly;
}
.car-name-tag .car-name{
  font-size: 40rpx;
}

.car-pic{
  padding-right: 30rpx;
  width: 30%;
}

.car-pic image{
  width: 100%;
}

.checkout-time-address{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-evenly;
  height: 60%;
}
.quche-time,.huanche-time{
  font-size: 30rpx;
}
.quche-address,.huanche-address{
  padding-left: 50rpx;
  width: 100%;
  overflow: hidden;
  text-overflow:ellipsis; 
  white-space:nowrap;
  font-size: 30rpx;
}
.address_info{
  font-size: 24rpx;
  color: gray;
}
/* 保险信息 */
.insurance_info{
  margin-top: 20rpx;
  border-radius: 20rpx;
  height: 300rpx;
  width: 100%;
  background-color:white;
  display:flex;
  flex-direction: column;
  justify-content: space-evenly;
}
.insurance_info_title{
  font-size: 35rpx;
  margin-left: 30rpx;
  
}
.insurance_info_content{
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-evenly;
}
.insurance_info_list{
  display: flex; 
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
}


/* 身份证信息 */
.user-info{
  margin-top: 20rpx;
  height: 150rpx;
  border-radius: 20rpx;
  width: 100%;
  background-color: white;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.user-info .title{
  padding-left: 30rpx;
  /* padding-top: 30rpx; */
  font-size:35rpx;
}
.driver-info{
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.user-info .driver-idcard{
  padding-left: 30rpx;
  margin-top: 10rpx;
  font-size: 25rpx;
}

.idcard_botton{
  width: 30%;
  margin-right: 30rpx;
  background-color:#000000;
  text-align: center;
  border-radius: 20rpx;
  color: white;
  font-size: 30rpx;
}

/* 身份证信息 */
.driver-phone{
  margin-top: 20rpx;
  height: 150rpx;
  border-radius: 20rpx;
  width: 100%;
  background-color: white;
  display: flex;
  flex-direction: column;
  justify-content: center;
  
}
.driver-phone text,.driver-phone input{
  padding-left: 30rpx;
}

/* 司机信息 */
.siji_info{
  background-color: white;
  margin-top: 20rpx;
  width: 100%;
  border-radius: 20rpx;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  /* padding-left: 40rpx; */
}

.siji_text{
  font-size: 25rpx;
  color: gray;
}


/* 订单金额计算 */
.cost-info{
  padding-top: 40rpx;
  padding-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background-color: white;
  margin-top: 20rpx;
  border-radius: 20rpx;
  width: 100%;
  /* height: 600rpx; */
}

.cost-info .title{
  padding-left: 30rpx;
  /* padding-top: 10rpx; */
  font-size: 35rpx;
}

.cost-info .sub-title{
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding-left: 30rpx;
  padding-top: 30rpx;
  font-size: 30rpx;
}

.sub-title-cost{
  padding-right: 30rpx;
}


.cost-info .sub-content{
  padding-left: 30rpx;
  font-size: 25rpx;
  color: #252B2C;
}

/* 优惠信息 */
.pms_info{
  margin-top: 20rpx;
  height: 200rpx;
  border-radius: 20rpx;
  width: 100%;
  background-color: white;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
}
.pms_info .title{
  margin-left: 30rpx;
}
.pms_info_list{
  margin-left: 30rpx;
}

.pms_info_list .pms_info_list_item{
  font-size: 25rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

/* 合同样式 */
checkbox .wx-checkbox-input {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  border-color: #B22222;
  background-color:white;
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked::before {
  color: #B22222;

}


.contract{
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  font-size: 30rpx;
  align-items: flex-end;
  color: white;
}
.contract  .contract_link{
  color: orange;
}
.contract  .contract_link{
  color: orange;
}

/* 提交订单按钮 */
.order-submit{
  /* flex: 1; */
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  background-color: white;
  margin-top: 20rpx;
  border-radius: 20rpx;
  width: 100%;
  height: 200rpx;
}
.order-submit .order-all-cost .cost-title{
  margin-right: 20rpx;
}


.order-submit .order-all-cost .cost-price{
  font-size: 50rpx;
  color: #B22222;
}

.order-submit .order-button{
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000;
  height: 50%;
  width: 40%;
  color: white;
  border-radius: 20rpx;
}
