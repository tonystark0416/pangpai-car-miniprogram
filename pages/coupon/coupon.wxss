/* pages/coupon/coupon.wxss 优惠券 */

.coupon_page {
  min-height: 100vh;
  background-color: var(--pp-bg);
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 顶部 Tab：iOS 分段胶囊 */
.cp_tabs {
  display: flex;
  flex-direction: row;
  background-color: var(--pp-card);
  border-radius: 88rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.cp_tab {
  flex: 1;
  text-align: center;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 28rpx;
  color: var(--pp-text-2);
  border-radius: 88rpx;
}
.cp_tab_active {
  background-color: var(--pp-blue);
  color: #FFFFFF;
  font-weight: 600;
}

.cp_tip {
  font-size: 24rpx;
  color: var(--pp-text-2);
  padding: 0 8rpx 16rpx;
}
.cp_empty {
  margin-top: 200rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--pp-text-2);
}

/* 券卡：左侧金额 + 中部信息 + 右侧操作 */
.cp_card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: var(--pp-card);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}
/* 左侧橙色票根条 */
.cp_card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background-color: var(--pp-orange);
}
.cp_card_off {
  opacity: 0.55;
}
.cp_card_off::before {
  background-color: var(--pp-text-2);
}
.cp_card_sel {
  border: 2rpx solid var(--pp-blue);
}

.cp_left {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  color: var(--pp-orange);
  width: 150rpx;
  flex-shrink: 0;
  padding-left: 12rpx;
  box-sizing: border-box;
}
.cp_card_off .cp_left {
  color: var(--pp-text-2);
}
.cp_symbol {
  font-size: 24rpx;
}
.cp_amount {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
  margin-left: 2rpx;
}

.cp_mid {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
  box-sizing: border-box;
}
.cp_name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--pp-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cp_date {
  font-size: 22rpx;
  color: var(--pp-text-2);
  margin-top: 6rpx;
}
.cp_stock {
  font-size: 22rpx;
  color: var(--pp-text-2);
  margin-top: 4rpx;
}
.cp_reason {
  font-size: 22rpx;
  color: var(--pp-red);
  margin-top: 6rpx;
}

.cp_right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.cp_status {
  font-size: 24rpx;
  color: var(--pp-text-2);
}
.cp_use {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--pp-blue);
  border: 2rpx solid var(--pp-blue);
  border-radius: 88rpx;
  padding: 4rpx 20rpx;
}
.cp_btn {
  background-color: var(--pp-orange);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 88rpx;
  padding: 10rpx 24rpx;
}
.cp_btn_off {
  background-color: var(--pp-sep);
  color: var(--pp-text-2);
}
