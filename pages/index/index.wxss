/**index.wxss —— 首页（iOS 风格）**/

/* banner 区域：卡片化圆角 */
.banner {
  padding: 24rpx 24rpx 0;
}
.banner image {
  width: 100%;
  border-radius: 32rpx;
  display: block;
}

/* 首页派券（v1.7.3）：横向滚动券卡 */
.coupon_zone {
  margin: 24rpx 24rpx 0;
  background-color: var(--pp-card);
  border-radius: var(--pp-radius-lg);
  padding: 24rpx 0 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.coupon_zone_title {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 16rpx;
}
.coupon_zone_title .cz_title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--pp-text);
}
.coupon_zone_title .cz_more {
  font-size: 24rpx;
  color: var(--pp-text-2);
}
.coupon_scroll {
  white-space: nowrap;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.coupon_card {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  width: 480rpx;
  margin-right: 16rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FF7A45 0%, #FF3B30 100%);
  color: #FFFFFF;
}
.coupon_card .cc_left {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-right: 16rpx;
}
.coupon_card .cc_symbol {
  font-size: 24rpx;
}
.coupon_card .cc_amount {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
  margin-left: 2rpx;
}
.coupon_card .cc_right {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.coupon_card .cc_name {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.coupon_card .cc_date {
  font-size: 20rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}
.coupon_card .cc_btn {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 88rpx;
  background-color: #FFFFFF;
  color: #FF3B30;
  font-size: 24rpx;
  font-weight: 600;
}
.coupon_card .cc_btn_off {
  background-color: rgba(255, 255, 255, 0.35);
  color: #FFFFFF;
}


/* 时间地址选择区域：白色卡片 */
.time_locate_zone {
  background-color: var(--pp-card);
  border-radius: var(--pp-radius-lg);
  margin: 24rpx;
  padding: 30rpx 0 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.timeInfo {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  padding: 10rpx 0 30rpx;
}

.timeInfo datetimepicker {
  width: 45%;
}

/* 地址选择 */
.locateSel {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  align-items: flex-start;
  padding-bottom: 10rpx;
}
.pickUpAddress, .returnAddress {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 40rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 28rpx;
  color: var(--pp-text-2);
}
.pickUpAddress + .returnAddress {
  border-top: 1rpx solid var(--pp-sep);
}

.pickUpAddress .b_text, .returnAddress .b_text {
  margin-left: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--pp-text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.server_text {
  font-size: 24rpx;
  color: var(--pp-text-2);
  margin-left: 40rpx;
  margin-top: 16rpx;
}

/* 汽车列表：双列瀑布流（卡片不等高，高度随图片与内容自适应） */
.con_list {
  padding: 0 24rpx 40rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start; /*两列顶部对齐，各自向下延伸，不强制等高 */
  justify-content: space-between;
}
.flow_col {
  width: 48.5%;
  display: flex;
  flex-direction: column;
}
.con_list .list {
  background-color: var(--pp-card);
  border-radius: var(--pp-radius);
  width: 100%;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding-bottom: 16rpx;
}
.img_list image {
  width: 100%;
}
.txt_list {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--pp-text);
  margin: 14rpx 0 0; /*瀑布流下不再定高，车名自然换行 */
  padding: 0 12rpx;
  line-height: 1.35;
  text-align: center;
}
/* 车辆标签：浅蓝填充胶囊（iOS chip 风格），单行过长省略 */
.tag_wrap {
  display: flex;
  flex-direction: row;
  justify-content: center;
  padding: 0 12rpx;
  margin-top: 10rpx;
}
.txt_tag {
  max-width: 100%;
  font-size: 22rpx;
  color: var(--pp-blue);
  background-color: rgba(0, 122, 255, 0.08);
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
  line-height: 1.45;
  text-align: center;
  word-break: break-all; /*标签过长时换行完整展示，不省略号截断 */
}
/* 价格区：优惠价为主视觉，原价与省钱标签为辅 */
.price_info {
  margin-top: 12rpx;
  padding: 0 12rpx;
}
.txt_Bonus {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
  color: var(--pp-orange);
  line-height: 1.1;
}
.txt_Bonus .price_symbol {
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 2rpx;
}
.txt_Bonus .price_num {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.txt_Bonus .price_unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--pp-text-2);
  margin-left: 4rpx;
}
/* 原价 + 省多少：同一行，居中 */
.price_sub {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 6rpx;
}
.txt_price {
  font-size: 22rpx;
  color: var(--pp-text-2);
  text-decoration: line-through;
}
.save_tag {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--pp-orange);
  background-color: rgba(255, 149, 0, 0.12);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}
