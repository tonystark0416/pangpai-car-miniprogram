/**index.wxss —— 首页（iOS 风格）**/

/* banner 区域：卡片化圆角 */
.banner {
  padding: 24rpx 24rpx 0;
}
.banner image {
  width: 100%;
  border-radius: 32rpx;
  display: block;
}

/* 时间地址选择区域：白色卡片 */
.time_locate_zone {
  background-color: var(--pp-card);
  border-radius: var(--pp-radius-lg);
  margin: 24rpx;
  padding: 30rpx 0 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.timeInfo {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  padding: 10rpx 0 30rpx;
}

.timeInfo datetimepicker {
  width: 45%;
}

/* 地址选择 */
.locateSel {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  align-items: flex-start;
  padding-bottom: 10rpx;
}
.pickUpAddress, .returnAddress {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 40rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 28rpx;
  color: var(--pp-text-2);
}
.pickUpAddress + .returnAddress {
  border-top: 1rpx solid var(--pp-sep);
}

.pickUpAddress .b_text, .returnAddress .b_text {
  margin-left: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--pp-text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.server_text {
  font-size: 24rpx;
  color: var(--pp-text-2);
  margin-left: 40rpx;
  margin-top: 16rpx;
}

/* 汽车列表：双列卡片 */
.con_list {
  padding: 0 24rpx 40rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}
.con_list .list {
  background-color: var(--pp-card);
  border-radius: var(--pp-radius);
  width: 48.5%;
  height: 480rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-bottom: 16rpx;
}
.img_list image {
  width: 100%;
}
.txt_list {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--pp-text);
  height: 60rpx;
  overflow: hidden;
  text-align: center;
}
.txt_tag {
  font-size: 24rpx;
  color: var(--pp-text-2);
  height: 40rpx;
  overflow: hidden;
  text-align: center;
}
.price_info {
  margin-top: 8rpx;
}
.txt_price {
  font-size: 24rpx;
  color: var(--pp-text-2);
  text-decoration: line-through;
}
.txt_Bonus {
  font-size: 32rpx;
  color: var(--pp-red);
  font-weight: 600;
}
