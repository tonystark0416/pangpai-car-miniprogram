<!-- 首页 -->
<!-- 引入wxs文件，用于过滤 -->
<wxs module="filters" src="../../utils/filter.wxs"></wxs>
<!-- 广告图 -->
<view class="banner">
  <image src="/img/index.jpeg" mode="widthFix"/>
</view>
<!-- 选择时间和地理位置 -->
<view class="time_locate_zone">
  <!-- 日期组件 -->
  <view class="timeInfo">
    <datetimepicker id="begin" bind:bindMultiPickerChange="bindMultiPickerChange" bind:bindCancel="bindCancel" b_txt="{{begin_time_txt}}" time = "{{quche_sourceTime}}" data-type="pickup">
    </datetimepicker>
    <datetimepicker id="end" bind:bindMultiPickerChange="bindMultiPickerChange" bind:bindCancel="bindCancel" b_txt="{{end_time_txt}}" time = "{{huanche_sourceTime}}" data-type="return">
    </datetimepicker>
  </view>
  <!-- 地址选择器 -->
  <view class = "locateSel">
    <view class="pickUpAddress" bindtap="getUserPoi" data-type="pickup">
        <text>送车上门地址:</text>
        <text class="b_text">{{pickup_address}} </text>
    </view>
    <view class="returnAddress" bindtap="getUserPoi" data-type="return">
        <text>上门收车地址:</text>
        <text class="b_text">{{return_address}}</text>
    </view>
    <view class="server_text">
      为了你的租乘体验，庞派租车默认送车上门和上门收车
    </view>
  </view>
</view>

<!-- 首页推荐列表 -->
