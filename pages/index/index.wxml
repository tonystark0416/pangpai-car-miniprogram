  <!-- 流式布局 -->
  <view class="con_list">
    <view class="list" wx:for="{{recCarList}}" wx:key='list' wx:for-item="item" bindtap="clickItem" data-car_id="{{item.id}}">
      <view class="img_list">
        <image src="{{item.image_url}}" mode="widthFix"></image>
      </view>
        <view class="txt_list">{{item.car_name}}</view>
        <view class="txt_tag">{{item.des}}</view>
        <view class="price_info">
          <view class="txt_price">单价¥ {{filters.toFix(item.day_price)}}/天</view>
          <view class="txt_Bonus">优惠价¥ {{filters.toFix(item.promotion_day_price)}}/天</view>
        </view>
    </view>
  </view>
</view>
