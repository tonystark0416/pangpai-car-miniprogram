<!-- 首页 -->
<!-- 引入wxs文件，用于过滤 -->
<wxs module="filters" src="../../utils/filter.wxs"></wxs>
<!-- 广告图 -->
<view class="banner">
  <image src="/img/index.jpeg" mode="widthFix"/>
</view>
<!-- 首页派券（v1.7.3）：有可领取批次才展示，无批次（含未登录）整块隐藏 -->
<view class="coupon_zone" wx:if="{{couponList.length > 0}}">
  <view class="coupon_zone_title">
    <text class="cz_title">租车优惠券</text>
    <text class="cz_more" bindtap="goCouponPage">领券中心 ›</text>
  </view>
  <scroll-view class="coupon_scroll" scroll-x="{{true}}" show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="coupon_card" wx:for="{{couponList}}" wx:key="coupon_id">
      <view class="cc_left">
        <text class="cc_symbol">¥</text><text class="cc_amount">{{item.amount}}</text>
      </view>
      <view class="cc_right">
        <view class="cc_name">{{item.name}}</view>
        <view class="cc_date">{{item.useTimeTxt}}</view>
      </view>
      <view class="cc_btn {{item.can_receive ? '' : 'cc_btn_off'}}" bindtap="receiveCoupon" data-index="{{index}}">{{item.btnTxt}}</view>
    </view>
  </scroll-view>
</view>

<!-- 选择时间和地理位置 -->
<view class="time_locate_zone">
  <!-- 日期组件 -->
  <view class="timeInfo">
    <datetimepicker id="begin" bind:bindMultiPickerChange="bindMultiPickerChange" bind:bindCancel="bindCancel" b_txt="{{begin_time_txt}}" time = "{{quche_sourceTime}}" data-type="pickup">
    </datetimepicker>
    <datetimepicker id="end" bind:bindMultiPickerChange="bindMultiPickerChange" bind:bindCancel="bindCancel" b_txt="{{end_time_txt}}" time = "{{huanche_sourceTime}}" data-type="return">
    </datetimepicker>
  </view>
  <!-- 地址选择器 -->
  <view class = "locateSel">
    <view class="pickUpAddress" bindtap="getUserPoi" data-type="pickup">
        <text>送车上门地址:</text>
        <text class="b_text">{{pickup_address}} </text>
    </view>
    <view class="returnAddress" bindtap="getUserPoi" data-type="return">
        <text>上门收车地址:</text>
        <text class="b_text">{{return_address}}</text>
    </view>
    <view class="server_text">
      为了你的租乘体验，庞派租车默认送车上门和上门收车
    </view>
  </view>
</view>

<!-- 首页推荐列表 -->
<view class="car_list">
  <!-- 选项卡tab -->
