/* pages/orderDetail/orderDetail.wxss */
page{
  background-color:#000000;
}
.order_detail_page{
  /* height: 100vh; */
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}
.order_info_status{
  margin-top: 20rpx;
  /* height: 5%; */
  text-align: center;
}
.order_info_status .order_status{
  font-size: 40rpx;
  color: white;
  text-align: center;
}
.unpay_des{
  font-size: 30rpx;
  color: white;
}



/* 订单信息 */
.order_info{
  background-color: white;
  height: 500rpx;
  border-radius: 20rpx;
  margin: 20rpx;
  display: flex;
  flex-direction: column;
}
.order_info .order_car_info{
  height: 200rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.order_car_info_image{
  width: 50%;
  height: 100%;
}
.order_car_info_image image{ 
  width: 100%;
  height: 100%;
}
.order_car_info_name{
  padding-left: 20rpx;
}
.order_info .line-style{
  background:gray;
  height: 3rpx;
  width: 95%;
  margin-top: 30rpx;
  /* position: relative; */
  align-self: center;
}
.order_address_time{
  height: 200rpx;
  margin-top: 30rpx;
  padding-left: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  align-items: flex-start;
}
/* 订单号信息 */
.order_sn_info{
  background-color: white;
  height: 150rpx;
  border-radius: 20rpx;
  margin: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  align-items: flex-start;
}
.order_sn_num,.order_book_time{
  margin-left: 20rpx;
}


/* 费用明细 */
.order_cost_info{
  background-color: white;
  /* height: 30%; */
  border-radius: 20rpx;
  margin: 20rpx;
  display: flex;
  flex-direction: column;
}
.order_cost_info .title{
  font-size: 30rpx;
  padding-top: 30rpx;
  padding-left: 30rpx
}

.order_cost_info .line-style{
  background:gray;
  height: 3rpx;
  width: 95%;
  /* position: relative; */
  margin-top: 5%;
  align-self: center;
}

.order_cost_info .cost1,.cost2,.cost3,.cost_all{
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding-top: 30rpx;
  padding-left: 30rpx;
  padding-right:30rpx;
  font-size: 30rpx;
}

/* 操作区域 */
.operation{
  height: 150rpx;
  background-color: white;
  border-radius: 20rpx;
  margin: 20rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-evenly;
  align-items: center;
}
.op_pay,.op_cancel,.op_kefu,.op_refund{
  height: 70rpx;
  width: 30%;
  background-color:#B22222 ;
  color: white;
  border-radius: 20rpx;
  text-align: center;
}


.op_refund button,.op_pay button,.op_cancel button,.op_kefu button{
  width: 100%;
  height: 100%;
  line-height: 70rpx;
}

/* 去掉背景色和内外边距 */
button {
  margin: 0;
  padding: 0;
  background-color: inherit;
  position: static;
  color: white;
}
button:after {
  content: none;
}
/* 去掉边框 */
button::after {
  border: none;
}
