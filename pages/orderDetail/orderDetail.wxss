/* pages/orderDetail/orderDetail.wxss —— iOS 风格 */

.order_detail_page {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding-bottom: 40rpx;
}

/* 订单状态头 */
.order_info_status {
  margin-top: 30rpx;
  text-align: center;
}
.order_info_status .order_status {
  font-size: 44rpx;
  font-weight: 600;
  text-align: center;
}
.unpay_des {
  font-size: 26rpx;
  color: var(--pp-text-2);
  margin-top: 12rpx;
}

/* 订单状态：iOS 语义色 */
.st_cancel { color: var(--pp-text-2); }
.st_unpay { color: var(--pp-orange); }
.st_paid { color: var(--pp-blue); }
.st_renting { color: var(--pp-green); }
.st_refunding { color: var(--pp-orange); }
.st_refunded { color: var(--pp-text-2); }
.st_done { color: var(--pp-green); }

/* 订单信息卡片 */
.order_info {
  background-color: var(--pp-card);
  border-radius: var(--pp-radius);
  margin: 30rpx 24rpx 20rpx;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.order_info .order_car_info {
  height: 200rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.order_car_info_image {
  width: 50%;
  height: 100%;
}
.order_car_info_image image {
  width: 100%;
  height: 100%;
}
.order_car_info_name {
  padding-left: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
}
.order_info .line-style,
.order_cost_info .line-style {
  background: var(--pp-sep);
  height: 1rpx;
  width: 92%;
  margin-top: 20rpx;
  align-self: center;
  border: none;
}
.order_address_time {
  padding: 30rpx 30rpx 10rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  align-items: flex-start;
  font-size: 26rpx;
  color: var(--pp-text-2);
  line-height: 1.9;
}

/* 订单号信息 */
.order_sn_info {
  background-color: var(--pp-card);
  border-radius: var(--pp-radius);
  margin: 0 24rpx 20rpx;
  padding: 24rpx 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  align-items: flex-start;
  font-size: 26rpx;
  color: var(--pp-text-2);
  line-height: 1.9;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 费用明细 */
.order_cost_info {
  background-color: var(--pp-card);
  border-radius: var(--pp-radius);
  margin: 0 24rpx 20rpx;
  padding: 30rpx 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.order_cost_info .title {
  font-size: 32rpx;
  font-weight: 600;
  padding-left: 30rpx;
}
.order_cost_info .cost1, .order_cost_info .cost2, .order_cost_info .cost3, .order_cost_info .cost_all {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  padding: 24rpx 30rpx 0;
  font-size: 28rpx;
}
.cost_name {
  color: var(--pp-text-2);
}
.cost_all .cost_name {
  color: var(--pp-text);
  font-weight: 600;
}
.cost_all .cost_price {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--pp-red);
}

/* 操作区域 */
.operation {
  padding: 10rpx 24rpx 0;
  display: flex;
  flex-direction: row;
  justify-content: space-evenly;
  align-items: center;
}
.op_pay, .op_cancel, .op_kefu, .op_refund {
  height: 88rpx;
  width: 44%;
  border-radius: 88rpx;
  text-align: center;
  overflow: hidden;
}

/* iOS 风格按钮 */
.btn_pay {
  width: 100%;
  height: 100%;
  line-height: 88rpx;
  border-radius: 88rpx;
  background-color: var(--pp-blue);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}
.btn_cancel {
  width: 100%;
  height: 100%;
  line-height: 88rpx;
  border-radius: 88rpx;
  background-color: var(--pp-card);
  color: var(--pp-text);
  border: 2rpx solid var(--pp-sep);
  font-size: 32rpx;
}
.btn_refund {
  width: 100%;
  height: 100%;
  line-height: 88rpx;
  border-radius: 88rpx;
  background-color: var(--pp-card);
  color: var(--pp-orange);
  border: 2rpx solid var(--pp-orange);
  font-size: 32rpx;
}
.btn_kefu {
  width: 100%;
  height: 100%;
  line-height: 88rpx;
  border-radius: 88rpx;
  background-color: var(--pp-card);
  color: var(--pp-text-2);
  border: 2rpx solid var(--pp-sep);
  font-size: 32rpx;
}

/* 重置原生 button */
button {
  margin: 0;
  padding: 0;
  background-color: inherit;
  position: static;
}
button::after {
  content: none;
  border: none;
}
