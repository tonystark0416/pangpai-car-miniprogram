/* pages/carDetail/carDetail.wxss 车辆详情（iOS 卡片风格，沿用全局设计变量） */
.car_detail_page {
  min-height: 100vh;
  background-color: var(--pp-bg);
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

/* 轮播图 */
.cd_swiper {
  width: 100%;
  height: 500rpx;
}
.cd_swiper_img {
  width: 100%;
  height: 500rpx;
  display: block;
}

/* 通用白卡片 */
.cd_card {
  margin: 20rpx 24rpx 0;
  padding: 28rpx 30rpx;
  background-color: var(--pp-card);
  border-radius: var(--pp-radius-lg);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.cd_card_title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--pp-text);
  margin-bottom: 20rpx;
}

/* 车名 / 卖点 / 标签 / 日租价 */
.cd_header .cd_name {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--pp-text);
}
.cd_header .cd_des {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--pp-text-2);
}
.cd_tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.cd_tag {
  padding: 6rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 8rpx;
  background-color: rgba(0, 122, 255, 0.08);
  color: var(--pp-blue);
  font-size: 24rpx;
}
.cd_price_row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-top: 12rpx;
}
.cd_price .cd_symbol {
  font-size: 26rpx;
  color: var(--pp-orange);
}
.cd_price .cd_price_num {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--pp-orange);
  line-height: 1;
  margin: 0 4rpx;
}
.cd_price .cd_unit {
  font-size: 24rpx;
  color: var(--pp-text-2);
}
.cd_price_old {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--pp-text-2);
  text-decoration: line-through;
}

/* 费用试算 */
.cd_time_row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: var(--pp-bg);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.cd_time_label {
  font-size: 26rpx;
  color: var(--pp-text-2);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.cd_time_value {
  font-size: 26rpx;
  color: var(--pp-text);
}
.cd_day_row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-top: 16rpx;
}
.cd_day_num {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--pp-text);
}
.cd_day_tip {
  font-size: 22rpx;
  color: var(--pp-text-2);
  margin-left: 8rpx;
}

/* 保险档位：两档二选一，切换后重新试算 */
.cd_ins_item {
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--pp-sep);
  background-color: var(--pp-bg);
}
.cd_ins_item:last-child {
  margin-bottom: 0;
}
.cd_ins_item.cd_ins_on {
  border-color: var(--pp-blue);
  background-color: rgba(0, 122, 255, 0.06);
}
.cd_ins_head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.cd_ins_name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--pp-text);
}
.cd_ins_price {
  font-size: 26rpx;
  color: var(--pp-blue);
}
.cd_ins_rule {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--pp-text-2);
}
.cd_fee_row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--pp-sep);
}
.cd_fee_left {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}
.cd_fee_name {
  font-size: 28rpx;
  color: var(--pp-text);
}
.cd_fee_desc {
  font-size: 22rpx;
  color: var(--pp-text-2);
  margin-top: 4rpx;
}
.cd_fee_value {
  font-size: 28rpx;
  color: var(--pp-text);
  flex-shrink: 0;
  margin-left: 20rpx;
}
.cd_fee_cut {
  color: var(--pp-orange);
}
.cd_fee_total {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
}
.cd_total_label {
  font-size: 28rpx;
  color: var(--pp-text);
  font-weight: 600;
}
.cd_total_price {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--pp-text);
}

/* 优惠券试算 */
.cd_coupon {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FF7A45 0%, #FF3B30 100%);
  color: #FFFFFF;
}
.cd_coupon_left {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-right: 20rpx;
}
.cd_coupon_symbol {
  font-size: 24rpx;
}
.cd_coupon_amount {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1;
}
.cd_coupon_right {
  flex: 1;
  min-width: 0;
}
.cd_coupon_name {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cd_coupon_tip {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}
.cd_coupon_result {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--pp-text);
}
.cd_coupon_pay {
  color: var(--pp-orange);
  font-weight: 600;
}
.cd_coupon_note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--pp-text-2);
}
.cd_coupon_empty {
  font-size: 26rpx;
  color: var(--pp-text-2);
  padding: 8rpx 0;
}

/* 未登录引导 */
.cd_login_tip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.cd_login_txt {
  font-size: 28rpx;
  color: var(--pp-text);
}
.cd_login_go {
  font-size: 28rpx;
  color: var(--pp-blue);
}

/* 车辆配置 */
.cd_config {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}
.cd_config_item {
  width: 50%;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 0;
  box-sizing: border-box;
}
.cd_config_key {
  width: 160rpx;
  font-size: 26rpx;
  color: var(--pp-text-2);
  flex-shrink: 0;
}
.cd_config_value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--pp-text);
}

/* 用户评价占位 */
.cd_review_empty {
  font-size: 26rpx;
  color: var(--pp-text-2);
  padding: 20rpx 0;
  text-align: center;
}

.cd_placeholder {
  height: 20rpx;
}

/* 底部固定栏 */
/* 底部栏：高度自适应（不再写死 height），安全区用 padding 叠加，避免内容被挤偏 */
.cd_footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 110rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background-color: var(--pp-card);
  border-top: 1rpx solid var(--pp-sep);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.cd_footer_label {
  font-size: 22rpx;
  color: var(--pp-text-2);
}
.cd_footer_amount {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--pp-orange);
  line-height: 1.1;
}
.cd_footer_symbol {
  font-size: 26rpx;
  margin-right: 2rpx;
}
.cd_footer_btn {
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 88rpx;
  background-color: var(--pp-blue);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

/* 加载 / 失败 */
.cd_loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--pp-text-2);
}
.cd_error {
  padding: 120rpx 0;
  text-align: center;
}
.cd_error_txt {
  font-size: 28rpx;
  color: var(--pp-text-2);
}
.cd_retry {
  margin: 30rpx auto 0;
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 88rpx;
  background-color: var(--pp-blue);
  color: #FFFFFF;
  font-size: 28rpx;
}
