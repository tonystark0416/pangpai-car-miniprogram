<!-- pages/orderList/orderList.wxml订单列表页面 -->
<view class="nologin" bind:tap="goLogin" hidden="{{islogin}}">请先进行登录</view>
<view class="noOrder" hidden="{{noOrder}}">暂无订单</view>
<view class="order_list_page">
  <view class="order_list_item" wx:for="{{orderList}}" wx:key="index" wx:for-index="indexs" wx:for-item="items" bindtap='goOrderDetail' data-ordersn='{{items.order_sn}}'>
    <view class="order_info_1">
      <view class="order_book_time">预定于 {{items.create_time}}</view>
      <view class="order_status {{items.statusClass}}">{{items.statusText}}</view>
    </view>
    <hr class="line-style"/>
    <view class="order_info_2">
      <view class="order_time_address">
        <view>订单号：{{items.order_sn}}</view>
        <view>取车时间 {{items.pickup_time_txt}}</view>
        <view>取车地址 {{items.pickup_address}}</view>
        <view>还车时间 {{items.return_time_txt}}</view>
        <view>还车地址 {{items.return_address}}</view>
      </view>
      <view class="order_car_info">
        <view class="car_info">车型 {{items.item_name}}</view>
        <view class="order_cost">¥{{items.total_price}}</view>
      </view>
    </view>
  </view>
</view>
